/* The guess API is defined in the parent class GuessGame.
   int guess(int num); */

public class Solution extends GuessGame {
    public int guessNumber(int n) {
        int left = 1, right = n;

        while (left <= right) {
            int mid = left + (right - left) / 2;
            int res = guess(mid);

            if (res == 0) {
                return mid; // tìm thấy
            } else if (res == -1) {
                right = mid - 1; // quá lớn
            } else {
                left = mid + 1; // quá nhỏ
            }
        }

        return -1; // không xảy ra
    }
}