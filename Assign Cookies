import java.util.*;

class Solution {
    public int findContentChildren(int[] g, int[] s) {
        Arrays.sort(g);
        Arrays.sort(s);
        
        int i = 0; // trẻ
        int j = 0; // bánh
        
        while (i < g.length && j < s.length) {
            if (s[j] >= g[i]) {
                i++; // thỏa mãn 1 trẻ
            }
            j++; // luôn thử bánh tiếp theo
        }
        
        return i;
    }
}