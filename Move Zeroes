class Solution {
    public void moveZeroes(int[] nums) {
        int j = 0;

        // Đưa các số khác 0 lên trước
        for (int i = 0; i < nums.length; i++) {
            if (nums[i] != 0) {
                nums[j] = nums[i];
                j++;
            }
        }

        // Điền số 0 vào phần còn lại
        while (j < nums.length) {
            nums[j] = 0;
            j++;
        }
    }
}