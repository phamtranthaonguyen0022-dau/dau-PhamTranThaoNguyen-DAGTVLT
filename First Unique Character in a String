class Solution {
    public int firstUniqChar(String s) {
        int[] count = new int[26];

        // Bước 1: đếm
        for (char c : s.toCharArray()) {
            count[c - 'a']++;
        }

        // Bước 2: tìm ký tự đầu tiên có count = 1
        for (int i = 0; i < s.length(); i++) {
            if (count[s.charAt(i) - 'a'] == 1) {
                return i;
            }
        }

        return -1;
    }
}