import java.util.*;

class Solution {
    public String[] findWords(String[] words) {
        String r1 = "qwertyuiop";
        String r2 = "asdfghjkl";
        String r3 = "zxcvbnm";
        
        int[] map = new int[26];
        
        for (char c : r1.toCharArray()) map[c - 'a'] = 1;
        for (char c : r2.toCharArray()) map[c - 'a'] = 2;
        for (char c : r3.toCharArray()) map[c - 'a'] = 3;
        
        List<String> res = new ArrayList<>();
        
        for (String word : words) {
            String w = word.toLowerCase();
            int row = map[w.charAt(0) - 'a'];
            boolean ok = true;
            
            for (char c : w.toCharArray()) {
                if (map[c - 'a'] != row) {
                    ok = false;
                    break;
                }
            }
            
            if (ok) res.add(word);
        }
        
        return res.toArray(new String[0]);
    }
}